---
import { extras } from '../data/photos';
import Photo from './Photo.astro';
---
<section class="extras" id="actividades" aria-labelledby="actividades-title">
  <div class="container">
    <h2 class="section-title" id="actividades-title">Además de la pileta</h2>
    <p class="section-lead">En Atlantis también hay colonia, inflables, pelotero acuático y juegos al aire libre. Y de vez en cuando, hasta cocina.</p>

    <ul class="grid" role="list">
      {extras.map((e, i) => (
        <li class:list={['item', `item--${i}`]}>
          <Photo photo={e.photo} sizes="(max-width: 760px) 50vw, 360px" widths={[400, 700, 1000]} />
          <span class="label">{e.title}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .extras { padding: var(--section) 0; }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(11rem, 18vw, 15rem);
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .item { position: relative; border-radius: var(--radius); overflow: hidden; background: var(--aqua-soft); }
  .item :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease-out); }
  .item:hover :global(img) { transform: scale(1.04); }
  .item--0 { grid-column: span 2; grid-row: span 2; }

  .label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--white);
    color: var(--blue-ink);
    font-weight: 700;
    font-size: 0.875rem;
    box-shadow: 0 6px 18px -8px rgb(10 26 63 / 0.4);
  }

  @media (max-width: 760px) {
    .grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 11rem; }
    .item--0 { grid-row: span 2; }
  }
</style>
