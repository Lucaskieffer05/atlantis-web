---
import { Image } from 'astro:assets';
import logo from '../assets/logo-badge.png';
import Icon from './Icon.astro';
import ContactButton from './ContactButton.astro';

const links = [
  { href: '#clases', label: 'Clases' },
  { href: '#rio', label: 'Río' },
  { href: '#competicion', label: 'Competición' },
  { href: '#actividades', label: 'Actividades' },
  { href: '#ubicacion', label: 'Dónde estamos' },
];
---
<header class="site-header" data-header>
  <div class="bar container">
    <a class="brand" href="#inicio" aria-label="Atlantis Escuela de Natación, inicio">
      <Image src={logo} alt="" width={64} height={55} densities={[1, 2]} loading="eager" />
      <span class="brand-name"><strong>Atlantis</strong> Escuela de Natación</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <ContactButton class="bar-cta" align="end" message="Hola, quería consultar por las clases de natación." />

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-toggle>
      <span class="visually-hidden" data-menu-label>Abrir menú</span>
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
    </button>
  </div>

  <div class="menu-panel" id="menu-panel" hidden data-menu-panel>
    <ul class="container">
      {links.map((l) => <li><a href={l.href} data-menu-link>{l.label}</a></li>)}
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    color: #fff;
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .site-header.is-solid,
  .site-header.is-open {
    background: rgb(255 255 255 / 0.97);
    color: var(--blue-ink);
    box-shadow: 0 6px 24px -14px rgb(10 26 63 / 0.35);
  }

  .bar { display: flex; align-items: center; gap: 2rem; height: 4.75rem; }

  .brand { display: flex; flex: none; align-items: center; gap: 0.85rem; text-decoration: none; }
  .brand img { width: 60px; height: auto; transform-origin: left center; transition: transform 0.3s var(--ease-out); }
  .is-solid .brand img { transform: scale(0.9); }
  .brand-name { display: grid; font-weight: 600; font-size: 0.875rem; line-height: 1.2; letter-spacing: 0.01em; white-space: nowrap; }
  .brand-name strong { font-size: 1.375rem; font-weight: 800; line-height: 1; letter-spacing: -0.02em; }

  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .nav a {
    display: block;
    padding: 0.6rem 0.9rem;
    border-radius: 999px;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .nav a:hover { background: rgb(255 255 255 / 0.16); }
  .is-solid .nav a:hover { background: var(--sky); }

  .menu-toggle {
    display: none;
    margin-left: auto;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .menu-toggle :global(.icon-close) { display: none; }
  .is-open .menu-toggle :global(.icon-open) { display: none; }
  .is-open .menu-toggle :global(.icon-close) { display: block; }

  .menu-panel ul { margin: 0 auto; padding: 0.5rem 0 1.25rem; list-style: none; }
  .menu-panel a {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  /* El menú completo necesita ~1100px; por debajo pasa a hamburguesa y el botón de WhatsApp sigue a la vista. */
  @media (max-width: 1100px) {
    .nav { display: none; }
    .menu-toggle { display: grid; margin-left: 0; }
    .bar { gap: 0.75rem; }
    .bar :global(.bar-cta) { margin-left: auto; }
  }
  @media (max-width: 860px) {
    .menu-toggle { margin-left: auto; }
    .bar :global(.bar-cta) { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const panel = header.querySelector<HTMLElement>('[data-menu-panel]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;
  const hero = document.querySelector('[data-hero]');

  // Sólido en cuanto la portada deja de estar detrás de toda la barra (la ola no alcanza para leer).
  const update = () => {
    const solid = !hero || hero.getBoundingClientRect().bottom < header.offsetHeight + 120;
    header.classList.toggle('is-solid', solid);
  };
  let ticking = false;
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { update(); ticking = false; });
  }, { passive: true });
  addEventListener('resize', update);
  update();

  const setOpen = (open: boolean) => {
    header.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    panel.hidden = !open;
  };

  toggle.addEventListener('click', () => setOpen(panel.hidden));
  panel.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) { setOpen(false); toggle.focus(); }
  });
</script>
