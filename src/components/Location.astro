---
import { site, contacts, contactLink, defaultMessage } from '../data/site';
import Icon from './Icon.astro';
---
<section class="location" id="ubicacion" aria-labelledby="ubicacion-title">
  <div class="container grid">
    <div class="body">
      <h2 class="section-title" id="ubicacion-title">Dónde estamos</h2>
      <p class="section-lead">Sobre calle Suchón, la misma del Hospital Suchón.</p>

      <dl class="info">
        <div>
          <dt><Icon name="pin" size={20} /> Dirección</dt>
          <dd>
            {site.address}, {site.city}<br />
            <a href={site.mapsUrl} target="_blank" rel="noopener">Cómo llegar</a>
          </dd>
        </div>
        <div>
          <dt><Icon name="whatsapp" size={20} /> WhatsApp</dt>
          <dd class="wa-list">
            {contacts.map((c) => (
              <a href={contactLink(c.name, defaultMessage)} target="_blank" rel="noopener">
                {c.name} · {c.display}
              </a>
            ))}
          </dd>
        </div>
        <div>
          <dt><Icon name="calendar" size={20} /> Horarios</dt>
          <dd>Consultanos los días y horarios de cada grupo.</dd>
        </div>
      </dl>

      <ul class="social" role="list">
        <li><a href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={20} /> Instagram</a></li>
        <li><a href={site.facebook} target="_blank" rel="noopener"><Icon name="facebook" size={20} /> Facebook</a></li>
      </ul>
    </div>

    <div class="map">
      <iframe
        title={`Mapa: Atlantis Escuela de Natación, ${site.address}, San Carlos Centro`}
        src={site.mapsEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location { padding: var(--section) 0; }
  .grid { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(2rem, 6vw, 5rem); align-items: stretch; }

  .info { display: grid; gap: 1.5rem; margin: 2.5rem 0 0; }
  .info div { display: grid; gap: 0.3rem; }
  dt { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--blue-ink); }
  dt :global(svg) { color: var(--blue); }
  dd { margin: 0 0 0 1.75rem; color: var(--ink-soft); }
  dd a { color: var(--blue); font-weight: 600; }
  .wa-list { display: grid; gap: 0.35rem; justify-items: start; }

  .social { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2.25rem 0 0; padding: 0; list-style: none; }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--sky);
    color: var(--blue-ink);
    font-weight: 700;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .social a:hover { border-color: var(--blue); color: var(--blue); }

  .map { min-height: 22rem; border-radius: var(--radius); overflow: hidden; background: var(--aqua-soft); }
  .map iframe { display: block; width: 100%; height: 100%; min-height: 22rem; border: 0; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
