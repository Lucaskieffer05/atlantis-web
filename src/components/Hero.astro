---
import { photos } from '../data/photos';
import { site } from '../data/site';
import Icon from './Icon.astro';
import ContactButton from './ContactButton.astro';
import Photo from './Photo.astro';

const { hero } = photos;
---
<section class="hero" id="inicio" data-hero>
  <div class="hero-media" aria-hidden="true">
    <Photo photo={hero} sizes="100vw" widths={[800, 1280, 1600, 2048]} eager decorative data-hero-img />
  </div>

  <div class="hero-body container">
    <h1 data-hero-line>Al agua todo el año.</h1>
    <p class="hero-lead" data-hero-line>Pileta cubierta y climatizada en San Carlos Centro.</p>
    <div class="hero-actions" data-hero-line>
      <ContactButton size="lg" placement="up" message="Hola, quería consultar por las clases de natación." />
      <a class="ghost-btn" href="#clases">Ver clases <Icon name="arrow" size={18} /></a>
    </div>
    <ul class="hero-paths" role="list" aria-label="Clases" data-hero-line>
      <li><a href="#chicos">Chicos y bebés</a></li>
      <li><a href="#adultos">Adultos</a></li>
      <li><a href="#competicion-grupo">Competición</a></li>
    </ul>
    <a class="hero-place" href={site.mapsUrl} target="_blank" rel="noopener" data-hero-line>
      <Icon name="pin" size={18} />
      {site.address}, San Carlos Centro
    </a>
  </div>

  <svg class="hero-wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 64c120 28 260 46 420 38s300-46 470-52 330 28 550 2v68H0Z" fill="currentColor" />
  </svg>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(100svh, 44rem);
    padding: 7rem 0 11rem;
    color: #fff;
    background: var(--blue-deep);
    overflow: hidden;
  }

  .hero-media { position: absolute; inset: 0; z-index: -1; }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(1 34 106 / 0.92) 0%, rgb(2 52 151 / 0.78) 38%, rgb(2 52 151 / 0.25) 72%, rgb(2 52 151 / 0.1) 100%),
      linear-gradient(180deg, rgb(1 34 106 / 0.45) 0%, transparent 28%);
  }

  .hero-body { display: grid; gap: 1.5rem; justify-items: start; }
  h1 { max-width: 11ch; font-size: clamp(3rem, 8.4vw, 6rem); font-weight: 800; letter-spacing: -0.035em; line-height: 0.98; }
  .hero-lead { max-width: 34rem; font-size: clamp(1.0625rem, 1.6vw, 1.25rem); line-height: 1.6; color: var(--on-blue-soft); }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 0.5rem; }
  .ghost-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 56px;
    padding: 0 1.5rem;
    border-radius: 999px;
    border: 1.5px solid rgb(255 255 255 / 0.7);
    color: #fff;
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .ghost-btn:hover { background: rgb(255 255 255 / 0.12); border-color: #fff; }
  .ghost-btn :global(svg) { transition: transform 0.25s var(--ease-out); }
  .ghost-btn:hover :global(svg) { transform: translateX(3px); }

  .hero-paths { display: none; }

  .hero-place {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    color: var(--on-blue-soft);
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .hero-place:hover { color: #fff; text-decoration: underline; }

  .hero-wave { position: absolute; left: 0; bottom: -1px; width: 100%; height: clamp(48px, 8vw, 120px); color: var(--white); }

  @media (max-width: 640px) {
    .hero { align-items: end; padding-top: 22rem; padding-bottom: 5.5rem; min-height: 0; }
    .hero-media { bottom: auto; height: 27rem; }
    .hero-media::after {
      background: linear-gradient(180deg, rgb(1 34 106 / 0.5) 0%, rgb(1 34 106 / 0) 22%, rgb(1 34 106 / 0) 55%, var(--blue-deep) 100%);
    }
    .hero-actions { width: 100%; }
    .hero-actions > :global(*) { flex: 1 1 100%; justify-content: center; }
    .hero-actions .ghost-btn { display: none; }
    .hero-paths { display: flex; flex-wrap: wrap; gap: 0.5rem; width: 100%; margin: 0; padding: 0; list-style: none; }
    .hero-paths li { flex: 1 1 auto; }
    .hero-paths a {
      display: grid;
      place-items: center;
      min-height: 48px;
      white-space: nowrap;
      padding: 0 0.75rem;
      border: 1.5px solid rgb(255 255 255 / 0.6);
      border-radius: 999px;
      color: #fff;
      font-weight: 700;
      font-size: 0.875rem;
      text-decoration: none;
    }
  }
</style>
