---
// Paso intermedio de cada consulta: Google Ads cuenta la visita como conversión y enseguida se abre WhatsApp.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo-solid.png';
---
<Base title="Gracias · Atlantis Escuela de Natación" description="Te estamos llevando a WhatsApp." noindex>
  <main class="thanks" id="contenido">
    <div class="card">
      <Image src={logo} alt="Atlantis" width={120} height={102} densities={[1, 2]} loading="eager" />
      <h1 class="section-title">¡Gracias por escribirnos!</h1>
      <p class="lead" data-thanks-text>Te estamos llevando a WhatsApp…</p>
      <a class="wa-btn" href="/#ubicacion" data-thanks-open>
        <Icon name="whatsapp" size={22} />
        <span>Abrir WhatsApp</span>
      </a>
      <p class="hint">Si WhatsApp no se abre solo, tocá el botón.</p>
      <a class="back" href="/">Volver a la página de Atlantis</a>
    </div>
  </main>
</Base>

<style>
  .thanks { display: grid; place-items: center; min-height: 100svh; padding: 2rem var(--gutter); background: var(--sky); }
  .card {
    display: grid;
    justify-items: center;
    gap: 1rem;
    width: min(100%, 30rem);
    padding: clamp(2rem, 6vw, 3rem) clamp(1.5rem, 5vw, 2.5rem);
    border-radius: var(--radius);
    background: var(--white);
    text-align: center;
    box-shadow: 0 18px 40px -24px rgb(10 26 63 / 0.45);
  }
  .card :global(img) { width: 104px; height: auto; margin-bottom: 0.5rem; }
  .lead { color: var(--ink-soft); }
  .wa-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 56px;
    margin-top: 0.5rem;
    padding: 0 1.75rem;
    border-radius: 999px;
    background: var(--wa);
    color: var(--wa-ink);
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    box-shadow: 0 6px 18px -6px rgb(2 20 70 / 0.35);
  }
  .wa-btn:hover { background: var(--wa-hover); }
  .hint { font-size: 0.875rem; color: var(--ink-soft); }
  .back { margin-top: 0.5rem; color: var(--blue); font-weight: 600; }
</style>

<script>
  import { contacts, waLink, defaultMessage } from '../data/site';

  const params = new URLSearchParams(location.search);
  const who = contacts.find((c) => c.name.toLowerCase() === params.get('a')) ?? contacts[0];
  const message = params.get('m') || defaultMessage;
  const desktop = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const url = waLink(who.phone, message, desktop);

  document.querySelector<HTMLElement>('[data-thanks-text]')!.textContent = `Te estamos llevando al WhatsApp de ${who.name}…`;
  const open = document.querySelector<HTMLAnchorElement>('[data-thanks-open]')!;
  open.href = url;
  open.querySelector('span')!.textContent = `Abrir WhatsApp de ${who.name}`;

  // Un instante para que la etiqueta de Google registre la visita; después se abre WhatsApp.
  setTimeout(() => location.replace(url), 1200);
</script>
